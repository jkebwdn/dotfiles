
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

"logo": {
  "type": "data",
  "source": "■■ ■■\n■■ ■■",
  "color": {
    "1": "38;2;162;104;98"
  },
  "padding": {
    "top": 1,
    "left": 2,
    "right": 4
  }
},

  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;162;104;98",
      "title": "38;2;162;104;98",
      "output": "white"
    },
    "key": {
      "width": 10
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "SYSTEM"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    "break",
    {
      "type": "custom",
      "format": "HARDWARE"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": [
        "C:"
      ]
    },
    {
      "type": "battery",
      "key": "Battery"
    }
  ]
}
