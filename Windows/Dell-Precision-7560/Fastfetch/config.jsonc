{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "████████  ████████\n████████  ████████\n████████  ████████\n████████  ████████\n                  \n████████  ████████\n████████  ████████\n████████  ████████\n████████  ████████",
    "color": {
      "1": "38;2;162;104;98"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;162;104;98",
      "title": "38;2;162;104;98",
      "output": "white"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "SYSTEM"
    },
    {
      "type": "custom",
      "key": "OS",
      "format": "Win 11 Business"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name} {version}"
    },
    "break",
    {
      "type": "custom",
      "format": "HARDWARE"
    },
    {
      "type": "custom",
      "key": "CPU",
      "format": "Intel Core i7-11850H"
    },
    {
      "type": "custom",
      "key": "GPU",
      "format": "NVIDIA T1200"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "battery",
      "key": "Power"
    }
  ]
}
