#!/usr/bin/env python3
"""Stable entry point; startup policy belongs to the optional Bash hook."""
import os
from pathlib import Path
import runpy
import sys
sys.dont_write_bytecode = True
source = Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))/'quickshell/magi/services/magi_fetch.py'
sys.path.insert(0,str(source.parent))
runpy.run_path(str(source),run_name='__main__')
