# Local package recipe. Render with prepare-source.py; no install script/hooks.
pkgname=magi-lock
pkgver=0.1.0
pkgrel=11
pkgdesc='MAGI native Wayland session locker and isolated PAM worker'
arch=('x86_64')
# Private local artifact; repository distribution licensing is not yet declared.
license=('LicenseRef-Local-Unlicensed')
depends=('glibc' 'gcc-libs' 'wayland' 'qt6-base' 'qt6-declarative'
         'libxkbcommon' 'pam' 'pambase' 'util-linux' 'systemd' 'systemd-libs'
         'hyprland' 'hypridle' 'sh' 'grep')
makedepends=('cmake' 'ninja' 'gcc' 'binutils' 'pkgconf' 'wayland-protocols' 'rust' 'python')
optdepends=('fprintd: fingerprint authentication; password always available')
backup=('etc/pam.d/magi-lock')
source=("magi-lock-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cmake -S "$srcdir/magi-lock-$pkgver" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DMAGI_LOCK_PRODUCTION_INSTALL=ON -DBUILD_TESTING=OFF
    cmake --build "$srcdir/build"
}

check() {
    DESTDIR="$srcdir/audit-root" cmake --install "$srcdir/build"
    python "$srcdir/magi-lock-$pkgver/tests/install_test.py" --audit "$srcdir/audit-root"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
