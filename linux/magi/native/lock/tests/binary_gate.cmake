# All invocations are informational or deliberately rejected BEFORE creating a
# Qt application or Wayland connection. Never pass --acquire-session-lock here.
execute_process(COMMAND "${BINARY}" --build-info RESULT_VARIABLE result OUTPUT_VARIABLE info)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Offline build-info failed")
endif()
if(DEVELOPMENT)
    if(NOT info MATCHES "development-unlock=1")
        message(FATAL_ERROR "Development build does not identify itself")
    endif()
else()
    if(NOT info MATCHES "development-unlock=0")
        message(FATAL_ERROR "Default build enabled unsafe unlock")
    endif()
endif()
execute_process(COMMAND "${BINARY}" --help RESULT_VARIABLE result OUTPUT_VARIABLE help)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Help failed")
endif()
if(NOT DEVELOPMENT AND help MATCHES "--unsafe-development-unlock")
    message(FATAL_ERROR "Production CLI advertises development escape")
endif()
execute_process(COMMAND "${BINARY}" --unsafe-development-unlock-after=30
    RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
if(NOT rejected EQUAL 64)
    message(FATAL_ERROR "Unsafe flag alone must fail before display connection")
endif()
find_program(NM nm REQUIRED)
execute_process(COMMAND "${NM}" -C "${BINARY}" RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Binary symbol inspection failed")
endif()
if(DEVELOPMENT)
    if(NOT symbols MATCHES "magi::WaylandOwner::developmentUnlockAndSync")
        message(FATAL_ERROR "Expected explicitly gated development implementation")
    endif()
else()
    if(symbols MATCHES "developmentUnlock|developmentTimer")
        message(FATAL_ERROR "Production binary contains development unlock implementation")
    endif()
endif()

if(NOT symbols MATCHES "magi::Controller::authenticatedUnlock")
    message(FATAL_ERROR "Authenticated unlock controller missing")
endif()
execute_process(COMMAND "${BINARY}" --authenticate RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 64)
    message(FATAL_ERROR "Authentication alone must not acquire a session lock")
endif()
