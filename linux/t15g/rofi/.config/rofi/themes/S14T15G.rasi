/* S14T15G Launcher - Rofi 2.x rebuild */

* {
    bg:       #0f1117;
    mantle:   #181825;
    base:     #1e1e2e;
    surface0: #313244;
    surface1: #45475a;
    text:     #cdd6f4;
    muted:    #a6adc8;
    blue:     #89b4fa;

    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @text;
}

configuration {
    display-drun: "";
    drun-display-format: "{name}";
}

window {
    width: 380px;
    height: 575px;
    border: 8px;
    border-color: @mantle;
    border-radius: 20px;
    background-color: @bg;
    padding: 0;
}

mainbox {
    background-color: @mantle;
    border-radius: 0px;
    padding: 0px;
    spacing: 0;
    children: [ imagebox, inputbar, listview ];
}

imagebox {
    background-color: transparent;
    background-image: url("/home/jkebwdn/Theme Resources/S14T15G/WofiHeader-rofi.png", height);
    border-radius: 0px;
    padding: 0;
    margin: 0;
}

inputbar {
    background-color: @mantle;
    border: 2px;
    border-color: @surface1;
    border-radius: 16px;
    padding: 14px 20px;
    margin: 20px 18px 18px;
    spacing: 10px;
    children: [ entry ];
}

entry {
    text-color: @text;
    placeholder: "Search";
    placeholder-color: @muted;
    cursor-color: @blue;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    padding: 10px 20px;
    background-color: transparent;
}

element {
    padding: 12px 16px;
    border-radius: 16px;
    background-color: transparent;
    text-color: @text;
    spacing: 12px;
}

element selected {
    background-color: @surface1;
    text-color: @text;
}

element-icon {
    size: 28px;
    padding: 0 8px 0 0;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
}

scrollbar {
    width: 0;
}

message {
    background-color: @mantle;
    border-radius: 12px;
    padding: 10px;
}

textbox {
    text-color: @text;
}
