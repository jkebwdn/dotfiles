
#!/bin/bash

# =========================================================
# SketchyBar
# Mac mini — Everforest Dark Hard
# =========================================================

# ---------------------------------------------------------
# Everforest Dark Hard Palette
# ---------------------------------------------------------

TRANSPARENT=0x00000000

BG_DIM=0xff1e2326
BG0=0xff272e33
BG1=0xff2e383c
BG2=0xff374145
BG3=0xff414b50
BG4=0xff495156
BG5=0xff4f5b58

FG=0xffd3c6aa

GREY0=0xff7a8478
GREY1=0xff859289
GREY2=0xff9da9a0

RED=0xffe67e80
ORANGE=0xffe69875
YELLOW=0xffdbbc7f
GREEN=0xffa7c080
AQUA=0xff83c092
BLUE=0xff7fbbb3
PURPLE=0xffd699b6


# =========================================================
# Bar
# =========================================================

sketchybar --bar \
    position=top \
    height=42 \
    sticky=on \
    margin=10 \
    y_offset=6 \
    padding_left=10 \
    padding_right=10 \
    color=$TRANSPARENT \
    shadow=off


# =========================================================
# Defaults
# =========================================================

sketchybar --default \
    icon.font="Hack Nerd Font:Regular:14.0" \
    icon.color=$FG \
    label.font="SF Pro:Medium:12.0" \
    label.color=$FG \
    padding_left=6 \
    padding_right=6


# =========================================================
# LEFT — Apple Menu
# =========================================================

sketchybar --add item apple.menu left \
           --set apple.menu \
                 icon="􀣺" \
                 icon.font="SF Pro:Regular:16.0" \
                 icon.color=$FG \
                 icon.padding_left=12 \
                 icon.padding_right=12 \
                 label.drawing=off \
                 padding_left=0 \
                 padding_right=0 \
                 popup.drawing=off \
                 popup.align=left \
                 popup.background.color=$BG_DIM \
                 popup.background.corner_radius=12 \
                 popup.background.border_width=1 \
                 popup.background.border_color=$BG3 \
                 popup.background.shadow.drawing=off \
                 click_script="sketchybar --set apple.menu popup.drawing=toggle"

sketchybar --add bracket apple_group apple.menu \
           --set apple_group \
                 background.drawing=on \
                 background.color=$BG_DIM \
                 background.height=32 \
                 background.corner_radius=12 \
                 background.border_width=1 \
                 background.border_color=$BG3


# ---------------------------------------------------------
# Apple Popup Items
# ---------------------------------------------------------

sketchybar --add item apple.settings popup.apple.menu \
           --set apple.settings \
                 icon="󰒓" \
                 label="System Settings" \
                 click_script="$HOME/.config/sketchybar/plugins/apple_menu.sh settings"

sketchybar --add item apple.lock popup.apple.menu \
           --set apple.lock \
                 icon="󰌾" \
                 label="Lock Screen" \
                 click_script="$HOME/.config/sketchybar/plugins/apple_menu.sh lock"

sketchybar --add item apple.sleep popup.apple.menu \
           --set apple.sleep \
                 icon="󰒲" \
                 label="Sleep" \
                 click_script="$HOME/.config/sketchybar/plugins/apple_menu.sh sleep"

sketchybar --add item apple.restart popup.apple.menu \
           --set apple.restart \
                 icon="󰜉" \
                 label="Restart…" \
                 click_script="$HOME/.config/sketchybar/plugins/apple_menu.sh restart"

sketchybar --add item apple.shutdown popup.apple.menu \
           --set apple.shutdown \
                 icon="󰐥" \
                 label="Shut Down…" \
                 click_script="$HOME/.config/sketchybar/plugins/apple_menu.sh shutdown"


# ---------------------------------------------------------
# Apple Popup Styling
# ---------------------------------------------------------

for item in \
    apple.settings \
    apple.lock \
    apple.sleep \
    apple.restart \
    apple.shutdown
do
    sketchybar --set "$item" \
        icon.font="Hack Nerd Font:Regular:14.0" \
        icon.color=$AQUA \
        icon.padding_left=12 \
        icon.padding_right=10 \
        label.font="SF Pro:Medium:12.0" \
        label.color=$FG \
        label.padding_left=0 \
        label.padding_right=16 \
        padding_left=5 \
        padding_right=5 \
        background.height=28 \
        background.corner_radius=7
done


# =========================================================
# LEFT — Time • Date
# =========================================================

sketchybar --add item clock left \
           --set clock \
                 icon.drawing=off \
                 update_freq=30 \
                 padding_left=16 \
                 padding_right=16 \
                 label.color=$FG \
                 label.font="SF Pro:Medium:12.0" \
                 script='sketchybar --set clock label="$(date "+%H:%M  •  %d/%m/%y")"'

sketchybar --add bracket left_group clock \
           --set left_group \
                 background.drawing=on \
                 background.color=$BG_DIM \
                 background.height=32 \
                 background.corner_radius=12 \
                 background.border_width=1 \
                 background.border_color=$BG3


# =========================================================
# CENTRE — Yabai / Native macOS Spaces
# =========================================================

for sid in 1 2 3 4; do

    sketchybar --add item space.$sid center \
               --subscribe space.$sid space_change \
               --set space.$sid \
                     icon.drawing=off \
                     label="$sid" \
                     label.font="SF Pro:Semibold:12.0" \
                     label.color=$GREY1 \
                     label.padding_left=9 \
                     label.padding_right=9 \
                     padding_left=5 \
                     padding_right=5 \
                     background.drawing=off \
                     background.height=20 \
                     background.corner_radius=7 \
                     background.color=$FG \
                     click_script="skhd -k 'ctrl - $sid'" \
                     script="$HOME/.config/sketchybar/plugins/yabai.sh $sid"

done

# Extra clearance at the outside edges of the pill
sketchybar --set space.1 padding_left=9
sketchybar --set space.4 padding_right=9

sketchybar --add bracket workspace_group '/space\..*/' \
           --set workspace_group \
                 background.drawing=on \
                 background.color=$BG_DIM \
                 background.height=32 \
                 background.corner_radius=12 \
                 background.border_width=1 \
                 background.border_color=$BG3


# =========================================================
# RIGHT — Wi-Fi + Volume
# =========================================================

# Right-side items are visually reversed.
# Declare volume before Wi-Fi to display Wi-Fi first.


# ---------------------------------------------------------
# Volume Icon
# ---------------------------------------------------------

sketchybar --add item volume.icon right \
           --subscribe volume.icon volume_change \
           --set volume.icon \
                 icon="󰕾" \
                 icon.font="Hack Nerd Font:Regular:15.0" \
                 icon.color=$BG_DIM \
                 icon.padding_left=7 \
                 icon.padding_right=7 \
                 label.drawing=off \
                 padding_left=4 \
                 padding_right=4 \
                 background.drawing=on \
                 background.color=$BLUE \
                 background.height=24 \
                 background.corner_radius=8 \
                 script="$HOME/.config/sketchybar/plugins/volume.sh" \
                 click_script='sketchybar --set volume.slider drawing=toggle'


# ---------------------------------------------------------
# Wi-Fi Icon
# ---------------------------------------------------------

sketchybar --add item wifi.icon right \
           --set wifi.icon \
                 icon="󰖩" \
                 icon.font="Hack Nerd Font:Regular:15.0" \
                 icon.color=$BG_DIM \
                 icon.padding_left=7 \
                 icon.padding_right=7 \
                 label.drawing=off \
                 padding_left=4 \
                 padding_right=4 \
                 background.drawing=on \
                 background.color=$AQUA \
                 background.height=24 \
                 background.corner_radius=8 \
                 update_freq=5 \
                 script="$HOME/.config/sketchybar/plugins/wifi.sh"


# ---------------------------------------------------------
# Volume Slider
# ---------------------------------------------------------

sketchybar --add slider volume.slider right 100 \
           --subscribe volume.slider mouse.clicked volume_change \
           --set volume.slider \
                 drawing=off \
                 slider.width=90 \
                 slider.highlight_color=$FG \
                 slider.background.color=$BG2 \
                 slider.background.height=5 \
                 slider.background.corner_radius=3 \
                 slider.knob="●" \
                 slider.knob.font="Hack Nerd Font:Regular:9.0" \
                 slider.knob.color=$FG \
                 padding_left=5 \
                 padding_right=8 \
                 script="$HOME/.config/sketchybar/plugins/volume_slider.sh"


# ---------------------------------------------------------
# Right Group Pill
# ---------------------------------------------------------

sketchybar --add bracket right_group \
           wifi.icon \
           volume.icon \
           volume.slider \
           --set right_group \
                 background.drawing=on \
                 background.color=$BG_DIM \
                 background.height=32 \
                 background.corner_radius=12 \
                 background.border_width=1 \
                 background.border_color=$BG3


# =========================================================
# Initial Yabai Workspace State
# =========================================================

for sid in 1 2 3 4; do
    sketchybar --set space.$sid \
        script="$HOME/.config/sketchybar/plugins/yabai.sh $sid"
done


# =========================================================
# Initial Update
# =========================================================

sketchybar --update
