#!/bin/bash

# =========================================================
# SketchyBar
# Mac mini — Forest / Viridian
# =========================================================


# ---------------------------------------------------------
# Colours
# ---------------------------------------------------------

TRANSPARENT=0x00000000

# Dark forest surface, slightly transparent
SURFACE=0xe6172421

TEXT=0xffd8e2dc
MUTED=0xff82968e

GREEN=0xff65a77b
TEAL=0xff54b6a5
ACCENT=0xff8fcf9b


# ---------------------------------------------------------
# Bar
# ---------------------------------------------------------

sketchybar --bar \
    position=top \
    height=36 \
    sticky=on \
    margin=8 \
    padding_left=8 \
    padding_right=8 \
    color=$TRANSPARENT \
    shadow=off


# ---------------------------------------------------------
# Default Item Styling
# ---------------------------------------------------------

sketchybar --default \
    icon.font="Hack Nerd Font:Regular:14.0" \
    icon.color=$TEXT \
    label.font="SF Pro:Medium:12.0" \
    label.color=$TEXT \
    padding_left=7 \
    padding_right=7


# ---------------------------------------------------------
# AeroSpace Event
# ---------------------------------------------------------

sketchybar --add event aerospace_workspace_change


# =========================================================
# LEFT
# Date / Time
# =========================================================

sketchybar --add item clock left \
           --set clock \
                 icon.drawing=off \
                 update_freq=30 \
                 padding_left=12 \
                 padding_right=12 \
                 script='sketchybar --set clock label="$(date "+%a %d %b  %H:%M")"'


# Left floating island
sketchybar --add bracket left_group clock \
           --set left_group \
                 background.color=$SURFACE \
                 background.corner_radius=9 \
                 background.height=28 \
                 background.drawing=on


# =========================================================
# CENTRE
# AeroSpace Workspaces
# =========================================================

for sid in 1 2 3 4; do

    sketchybar --add item space.$sid center \
               --subscribe space.$sid aerospace_workspace_change \
               --set space.$sid \
                     label="$sid" \
                     icon.drawing=off \
                     label.font="SF Pro:Semibold:12.0" \
                     label.padding_left=9 \
                     label.padding_right=9 \
                     background.height=22 \
                     background.corner_radius=6 \
                     background.color=$TEAL \
                     background.drawing=off \
                     click_script="aerospace workspace $sid" \
                     script="$HOME/.config/sketchybar/plugins/aerospace.sh $sid"

done


# Centre floating island
sketchybar --add bracket workspace_group '/space\..*/' \
           --set workspace_group \
                 background.color=$SURFACE \
                 background.corner_radius=9 \
                 background.height=28 \
                 background.drawing=on


# =========================================================
# RIGHT
# Wi-Fi + Interactive Volume
# =========================================================


# ---------------------------------------------------------
# Wi-Fi
# ---------------------------------------------------------

sketchybar --add item wifi right \
           --subscribe wifi wifi_change system_woke \
           --set wifi \
                 icon="󰖩" \
                 icon.font="Hack Nerd Font:Regular:15.0" \
                 icon.color=$TEAL \
                 label.drawing=off \
                 padding_left=10 \
                 padding_right=7 \
                 update_freq=10 \
                 script="$HOME/.config/sketchybar/plugins/wifi.sh"


# ---------------------------------------------------------
# Volume
# ---------------------------------------------------------

sketchybar --add item volume right \
           --subscribe volume volume_change \
           --set volume \
                 icon="󰕾" \
                 icon.font="Hack Nerd Font:Regular:16.0" \
                 icon.color=$GREEN \
                 label.drawing=off \
                 padding_left=7 \
                 padding_right=10 \
                 script="$HOME/.config/sketchybar/plugins/volume.sh" \
                 click_script='sketchybar --set volume.slider drawing=toggle'


# ---------------------------------------------------------
# Volume Slider
# ---------------------------------------------------------

sketchybar --add slider volume.slider right 100 \
           --subscribe volume.slider mouse.clicked volume_change \
           --set volume.slider \
                 drawing=off \
                 slider.width=100 \
                 slider.highlight_color=$TEAL \
                 slider.background.color=$SURFACE \
                 slider.background.height=6 \
                 slider.background.corner_radius=3 \
                 slider.knob="●" \
                 slider.knob.font="Hack Nerd Font:Regular:10.0" \
                 slider.knob.color=$TEXT \
                 script="$HOME/.config/sketchybar/plugins/volume_slider.sh"


# Right floating island
sketchybar --add bracket right_group wifi volume volume.slider \
           --set right_group \
                 background.color=$SURFACE \
                 background.corner_radius=9 \
                 background.height=28 \
                 background.drawing=on


# =========================================================
# Initial AeroSpace Workspace State
# =========================================================

FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"

sketchybar --trigger aerospace_workspace_change \
           FOCUSED_WORKSPACE="$FOCUSED_WORKSPACE"


# ---------------------------------------------------------
# Initial Update
# ---------------------------------------------------------

sketchybar --update
